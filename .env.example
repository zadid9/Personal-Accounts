# Copy this file to .env and fill in your values. Never commit .env.

# Show PHP error details in the browser. Keep false on a live site.
APP_DEBUG=false

# Let new visitors create accounts.
ALLOW_REGISTRATION=true

# Full address of the app, used for links in emails. No trailing slash.
APP_URL=https://example.com/finance

# Sender for password reset and verification emails. Mail goes out through PHP's
# mail() (the server's sendmail/Postfix), so the domain's SPF must allow this server.
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=ব্যক্তিগত হিসাব

DB_HOST=localhost
DB_PORT=3306
DB_NAME=personal_finance
DB_USER=
DB_PASSWORD=

# utf8mb4 for every new install.
# Installs created before November 2026 stored text through a latin1 connection and
# must use latin1 here until their data is converted.
DB_CHARSET=utf8mb4

# Only when the site sits behind a reverse proxy or CDN, the header carrying the visitor's
# real IP, e.g. CF-Connecting-IP or X-Forwarded-For. Leave empty otherwise.
CLIENT_IP_HEADER=
